APP_ENV=development
APP_NAME=Muggle
HTTP_ADDR=:8080
LOG_LEVEL=debug
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# MySQL 仅用于本地开发。真实项目中请替换下面的示例密码。
MYSQL_ROOT_PASSWORD=change-root-me
MYSQL_HOST=127.0.0.1
# Docker MySQL 映射到本机标准端口 3306。
MYSQL_PORT=3306
MYSQL_DATABASE=tiny_blog
MYSQL_USER=blog
MYSQL_PASSWORD=change-me
MYSQL_MAX_OPEN_CONNS=20
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=30m

# 阶段五 Redis 缓存配置（公开文章缓存，允许随时清空，不存业务事实数据）。
# 本地开发 Redis 默认不设密码；完整 Compose 环境里改用 redis:6379。
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=1s
REDIS_READ_TIMEOUT=500ms
REDIS_WRITE_TIMEOUT=500ms

# 阶段三认证配置。
# JWT_SECRET 请用 `openssl rand -hex 32` 生成独立随机值，不要与示例相同。
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_SESSION_TTL=168h
REFRESH_COOKIE_NAME=muggle_refresh
# 本地开发走 HTTP 因此为 false；生产环境必须是 true。
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax
PUBLIC_ORIGIN=http://localhost:5173

# 阶段六 Kafka 浏览事件配置。
# Kafka 是可选依赖：broker 不可用时文章读取不受影响，只是会少算浏览量。
# 多个 broker 用逗号分隔；完整 Compose 环境里改用 kafka:9092。
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC=blog.post-viewed.v1
KAFKA_CONSUMER_GROUP=blog-view-counter-v1

# 阶段六 Worker 进程配置。Worker 独立消费 Kafka 浏览事件并幂等更新浏览量。
# 内部健康检查端点默认监听 8081，与 API 的 8080 错开，仅供探针使用。
WORKER_HTTP_ADDR=:8081
WORKER_SHUTDOWN_TIMEOUT=10s
